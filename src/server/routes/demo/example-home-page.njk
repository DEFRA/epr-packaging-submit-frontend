{% extends "layouts/main.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">EPR for packaging</h1>

      <table class="govuk-table app-dashboard-tasks">
        <colgroup>
          <col class="app-dashboard-tasks__period">
          <col class="app-dashboard-tasks__deadline">
          <col class="app-dashboard-tasks__status">
          <col class="app-dashboard-tasks__action">
        </colgroup>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Reporting period</th>
            <th scope="col" class="govuk-table__header">Deadline</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header govuk-!-text-align-right">Action</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">
              2026
              <br>
              <span class="govuk-!-font-weight-regular">July to Dec (H2)</span>
            </th>
            <td class="govuk-table__cell">1 April 2027</td>
            <td class="govuk-table__cell">
              {{ govukTag({ text: "Not started", classes: "govuk-tag--blue" }) }}
            </td>
            <td class="govuk-table__cell govuk-!-text-align-right">
              <a class="govuk-link" href="/demo/example-start-page?period=2026">Report now</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
