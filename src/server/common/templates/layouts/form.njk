{#
  Form layout conventions:
  - Controllers pass caption (and usually heading / pageTitle / backLinkHref).
  - This layout renders the journey caption — pages must not output govuk-caption-* themselves.
  - headingSize (default "l", not "xl") sizes both the heading and caption together;
    override headingSize once if a page needs a different shared size.
  - Legend-as-page-heading pages should use the same headingSize on the fieldset legend.
  - headingMode controls title composition to avoid duplicate h1s / captions:
      appHeading (default when heading is set) — caption + h1 via appHeading
      legend — caption only; page supplies h1 via fieldset legend isPageHeading
      none — neither caption nor appHeading (page owns the full title, e.g. confirmation)
#}
{% extends "layouts/main.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set showBackLink = true %}
{% set caption = caption | default("epr-packaging-submit-frontend") %}
{# Large (l): form questions match caption + heading; do not use xl here #}
{% set headingSize = headingSize | default("l") %}
{% set buttonText = buttonText | default("Continue") %}
{% set buttonClasses = buttonClasses | default("") %}
{% if not headingMode %}
  {% set headingMode = "appHeading" if heading else "none" %}
{% endif %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="{{ formMethod | default('post') }}" action="{{ formAction | default('#') }}" novalidate>
        {% if headingMode == "appHeading" %}
          {{ appHeading({
            text: heading,
            caption: caption,
            size: headingSize
          }) }}
        {% elif headingMode == "legend" %}
          <span class="govuk-caption-{{ headingSize }}"
                data-testid="app-heading-caption">{{ caption }}</span>
        {% endif %}

        {% block formContent %}{% endblock %}

        {% block formButton %}
          {{ govukButton({
            text: buttonText,
            classes: buttonClasses,
            type: "submit"
          }) }}
        {% endblock %}
      </form>
    </div>
  </div>
{% endblock %}
